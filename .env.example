# Copy to .env.local and fill in.

# --- Sign-in (Clerk) ---
# Leave both unset in development: Clerk's keyless mode creates temporary keys on first load
# and shows a "Claim application" prompt to attach them to your Clerk account.
# For staging and production, copy the keys from https://dashboard.clerk.com (API keys).
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Local role testing without Clerk: pick a seeded user (Prem, Rahul, Riya) from the account menu.
# Refused in production.
# AUTH_MODE=dev

# --- Database ---
# Leave unset to use the built-in local Postgres (PGlite, stored in .data/).
# Set it to a hosted Postgres (Supabase or Neon, Mumbai region) for staging and production,
# then run `npm run db:migrate`. Connect as the database owner; queries drop to app_user per request.
# DATABASE_URL=postgres://user:password@host:5432/growth_os

# --- Email (Resend) ---
# Invite emails. Without a key, invites are still created and the page shows the link to copy or share on WhatsApp.
# Create a key at https://resend.com/api-keys. Until you verify a domain, Resend only delivers from
# onboarding@resend.dev to your own Resend account email.
# RESEND_API_KEY=re_...
# EMAIL_FROM="Plotline <team@your-domain.in>"

# Public address used in email links. Required in production.
# APP_URL=https://app.your-domain.in

# --- AI Copilot (Claude) ---
# Create a key at https://platform.claude.com (API keys). Without it, AI features show a setup message.
# AI usage is metered in credits (1 credit = US$0.01) against each organisation's monthly budget.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Instagram and Facebook (Meta) ---
# Create an app at https://developers.facebook.com (type Business), add "Facebook Login for Business",
# and register <APP_URL>/api/meta/callback as a valid OAuth redirect URI. Until Meta's app review
# approves the permissions, only people with a role on the app can connect.
# Without these keys, development runs in sample mode: the same flow on generated accounts.
# META_APP_ID=
# META_APP_SECRET=
# META_FAKE=1                      # force sample mode even with keys set

# Encrypts stored platform tokens (AES-256-GCM). Required in production: openssl rand -base64 32
# In development a key is generated into .data/token.key.
# TOKEN_ENCRYPTION_KEY=

# --- Background jobs ---
# Imports, hourly metric syncs and daily token checks run inside `npm run dev`. In production run
# `npm run worker` as its own process (needs DATABASE_URL), or set JOBS_IN_PROCESS=1 to keep them in the web server.
# JOBS_IN_PROCESS=1

# --- Browser notifications (Web Push) ---
# Required in production: npx web-push generate-vapid-keys. In development a pair is generated into .data/vapid.json.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@yourdomain.com

# --- Billing ---
# Without these, billing runs in sample mode: no payments are taken. Prices are drafts in src/lib/billing/plans.ts.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# STRIPE_SECRET_KEY=

# Optional links in the sidebar's Community menu; each appears only when set.
# NEXT_PUBLIC_COMMUNITY_URL=https://chat.whatsapp.com/...
# NEXT_PUBLIC_AFFILIATE_URL=https://your-domain.in/affiliates

# Where Support Center tickets are emailed (they're always saved in the support_tickets table).
# SUPPORT_EMAIL=support@your-domain.in
